<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <include
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            layout="@layout/layout_appbar" />
        <FrameLayout
            android:layout_width="fill_parent"
            android:layout_height="0.0dip"
            android:layout_weight="1.0">
            <WebView
                android:id="@id/speed_test_webview"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent" />
            <ProgressBar
                android:id="@id/speed_test_progress"
                android:layout_gravity="center"
                android:layout_width="48.0dip"
                android:layout_height="48.0dip"
                android:indeterminate="true" />
            <LinearLayout
                android:orientation="horizontal"
                android:id="@id/speed_test_url_bar"
                android:background="#66000000"
                android:padding="8.0dip"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <EditText
                    android:id="@id/speed_test_url_input"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.0"
                    android:singleLine="true"
                    android:imeOptions="actionGo"
                    android:inputType="textUri"
                    android:hint="https://t-mobile.speedtestcustom.com" />
                <Button
                    android:id="@id/speed_test_ok_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ок"
                    android:onClick="onSpeedTestOkClick" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
