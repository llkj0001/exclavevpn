<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:id="@id/coordinator"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <include
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        layout="@layout/layout_appbar" />
    <LinearLayout
        android:gravity="center"
        android:id="@id/wait_layout"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <TextView
            android:textAppearance="@style/AppearanceFoundation.Title"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/stun_attest_loading" />
    </LinearLayout>
    <androidx.core.widget.NestedScrollView
        android:id="@id/main_layout"
        android:clipToPadding="false"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent">
            <com.google.android.material.card.MaterialCardView
                android:focusable="true"
                android:clickable="true"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16.0dip"
                android:layout_marginTop="16.0dip"
                android:layout_marginRight="16.0dip"
                app:cardElevation="2.0dip">
                <LinearLayout
                    android:orientation="vertical"
                    android:padding="16.0dip"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textAppearance="?textAppearanceSubtitle2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/server_address" />
                    <EditText
                        android:id="@id/probe_cert_server"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text" />
                    <TextView
                        android:textAppearance="?textAppearanceSubtitle2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/server_port" />
                    <EditText
                        android:id="@id/probe_cert_server_port"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number" />
                    <TextView
                        android:textAppearance="?textAppearanceSubtitle2"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/sni" />
                    <EditText
                        android:id="@id/probe_cert_server_name"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text" />
                    <TextView
                        android:textAppearance="?textAppearanceSubtitle2"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/alpn" />
                    <EditText
                        android:id="@id/probe_cert_alpn"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text" />
                    <TextView
                        android:textAppearance="?textAppearanceSubtitle2"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/protocol" />
                    <Spinner
                        android:entries="@array/probe_cert_protocol"
                        android:id="@id/probe_cert_protocol"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <LinearLayout
                android:gravity="end"
                android:orientation="horizontal"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16.0dip"
                android:layout_marginRight="16.0dip">
                <Button
                    android:textColor="?primaryOrTextPrimary"
                    android:id="@id/probeCert"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/start"
                    android:layout_marginEnd="8.0dip"
                    style="@style/Widget.AppCompat.Button.Borderless" />
            </LinearLayout>
            <com.google.android.material.card.MaterialCardView
                android:id="@id/certificateCard"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16.0dip"
                android:layout_marginTop="16.0dip"
                android:layout_marginRight="16.0dip"
                android:layout_marginBottom="16.0dip"
                app:cardElevation="2.0dip">
                <LinearLayout
                    android:orientation="vertical"
                    android:padding="16.0dip"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textAppearance="?textAppearanceSubtitle2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/certificates" />
                    <EditText
                        android:textAppearance="?textAppearanceBody2"
                        android:typeface="monospace"
                        android:textColor="?android:textColorSecondary"
                        android:id="@id/certificate"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:maxLines="3"
                        android:singleLine="false"
                        android:inputType="textMultiLine" />
                    <Spinner
                        android:entries="@array/cert_hash_type"
                        android:id="@id/cert_hash_type"
                        android:paddingTop="8.0dip"
                        android:paddingBottom="8.0dip"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content" />
                    <TextView
                        android:textAppearance="?textAppearanceBody2"
                        android:typeface="monospace"
                        android:textColor="?android:textColorSecondary"
                        android:id="@id/certHash"
                        android:padding="8.0dip"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:textIsSelectable="true" />
                    <LinearLayout
                        android:gravity="end"
                        android:orientation="horizontal"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content">
                        <Button
                            android:textColor="?primaryOrTextPrimary"
                            android:id="@id/showCertInfo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/Widget.AppCompat.Button.Borderless" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>